# Copy to .env.local and fill in. Every service below has a free tier.

# --- App ---------------------------------------------------------------
# Public URL of the app (http://localhost:3000 locally, your onrender.com URL in prod)
APP_URL=http://localhost:3000
# Signs the approval links sent to the treasurer (32+ random characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# --- Database: Neon (free forever) — console.neon.tech -> Connection details
# Pooled connection string — host contains "-pooler", e.g.
#   postgresql://neondb_owner:abc123@ep-cool-name-a1b2c3-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Direct connection string — same as above WITHOUT "-pooler" (Neon: turn "Connection pooling" off to copy it)
DATABASE_URL_DIRECT=

# --- PayPal sandbox — developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after you add a webhook URL to the sandbox app (needed for signature verification)
PAYPAL_WEBHOOK_ID=
# Leave as sandbox for the hackathon
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_SDK_URL=https://www.sandbox.paypal.com/web-sdk/v6/core
# Sandbox BUSINESS account that stands in for retailers (receives purchase payments)
SANDBOX_PAYEE_EMAIL=
# Sandbox PERSONAL account that receives volunteer reimbursements (Payouts)
SANDBOX_VOLUNTEER_EMAIL=

# --- AI: Google AI Studio (free tier) — aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Flash models are on the free tier; Pro models are not. Gemini 2.5 Flash was shut down on Oct 16, 2026
AI_MODEL=gemini-3.5-flash
# Embeddings for policy, history and duplicate search (same key). Changing the model means re-running npm run db:index
EMBEDDING_MODEL=gemini-embedding-2

# --- Channel3 product search — trychannel3.com/developers (promo PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# --- Approval notices to the treasurer (all optional; the Mandates page always lists requests)
# Zapier MCP: mcp.zapier.com -> your MCP server -> Connect -> copy the server URL. Enable a Slack "Send Channel Message"
# and a Gmail "Send Email" action there. ZAPIER_MCP_TOOLS optionally names the tools to call (comma-separated).
ZAPIER_MCP_URL=
ZAPIER_MCP_TOKEN=
ZAPIER_MCP_TOOLS=
ZAPIER_SLACK_CHANNEL=treasurer
# Slack incoming webhook (api.slack.com/apps -> Incoming Webhooks), used if Zapier is off or fails
SLACK_WEBHOOK_URL=
# Resend email (resend.com, free tier). Without your own domain, onboarding@resend.dev can only send to your own address
RESEND_API_KEY=
RESEND_FROM=Quartermaster <onboarding@resend.dev>
TREASURER_EMAIL=

# --- KERNEL cloud browser for live price checks (kernel.sh, $50 hackathon credits)
KERNEL_API_KEY=

# --- AG Studio treasurer dashboard (45-day trial from ag-grid.com/studio). Empty = the AG Grid Community dashboard.
# The Treasurer assistant inside it uses GOOGLE_GENERATIVE_AI_API_KEY above.
AG_STUDIO_LICENSE_KEY=

# --- Elastic (Day 19). Off by default. Local: `docker compose up -d elasticsearch` → ELASTIC_URL=http://localhost:9200, no key,
# then `npm run elastic:sync`. Adds hybrid search, agent traces (qm-events) and the ES|QL anomaly tile on /treasurer.
# Cloud: the deployment's Elasticsearch endpoint and an API key. ELASTIC_INFERENCE_ID (e.g. a Jina embeddings endpoint)
# turns on hybrid search; empty = keyword (BM25) only.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INFERENCE_ID=
ELASTIC_ENABLED=false

# --- Feature flags: "true" uses the live service, "false" uses the built-in fallback
CHANNEL3_ENABLED=true
# pgvector search; "false" falls back to keyword matching
EMBEDDINGS_ENABLED=true
KERNEL_ENABLED=true
ZAPIER_ENABLED=true
SLACK_ENABLED=true
RESEND_ENABLED=true
# "false" shows the AG Grid Community dashboard even with a licence key (e.g. after the trial ends)
AG_STUDIO_ENABLED=true
