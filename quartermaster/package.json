{
  "name": "quartermaster",
  "version": "0.1.0",
  "private": true,
  "description": "AI purchasing agent for volunteer teams: buys and reimburses with PayPal, only inside human-signed spending mandates.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "tsx scripts/db-push.ts",
    "db:seed": "tsx scripts/seed.ts",
    "check:env": "tsx scripts/check-env.ts",
    "setup": "npm run check:env && npm run db:vector && npm run db:push && npm run db:migrate && npm run db:seed && npm run setup:dues",
    "spike:payout": "tsx scripts/spike-payout.ts",
    "db:vector": "tsx scripts/db-vector.ts",
    "db:index": "tsx scripts/index-search.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "setup:dues": "tsx scripts/setup-dues.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.134",
    "@ai-sdk/react": "3.0.311",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@neondatabase/serverless": "1.0.1",
    "@onkernel/sdk": "0.121.0",
    "ag-charts-community": "14.2.0",
    "ag-charts-react": "14.2.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ai": "6.0.308",
    "drizzle-orm": "0.44.2",
    "next": "^15.5.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.10",
    "@types/node": "22.15.32",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "16.5.0",
    "drizzle-kit": "0.31.1",
    "tailwindcss": "4.1.10",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
