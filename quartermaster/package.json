{
  "name": "quartermaster",
  "version": "0.1.0",
  "private": true,
  "description": "AI purchasing agent for volunteer teams: buys and reimburses with PayPal, only inside human-signed spending mandates.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "check:env": "tsx scripts/check-env.ts",
    "setup": "npm run check:env && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.134",
    "@ai-sdk/react": "3.0.311",
    "@neondatabase/serverless": "1.0.1",
    "ai": "6.0.308",
    "drizzle-orm": "0.44.2",
    "next": "^15.5.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.10",
    "@types/node": "22.15.32",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "16.5.0",
    "drizzle-kit": "0.31.1",
    "tailwindcss": "4.1.10",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
